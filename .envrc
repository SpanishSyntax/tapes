#!/usr/bin/env bash

if ! has sccache; then
  export RUSTC_WRAPPER=""
fi

if has devenv; then
	eval "$(devenv direnvrc)"
	use devenv
fi

if has mold; then
  export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS="-C link-arg=-fuse-ld=mold"
fi

PATH_add target/debug

shopt -s globstar
watch_file src/**/*.rs

cargo build
